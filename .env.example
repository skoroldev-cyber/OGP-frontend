# One Global People — frontend environment.
# Everything here is PUBLIC (Vite inlines VITE_* into the bundle).
# Gateway security keys, database URIs and mail credentials are server-side only.

# API origin. Empty string = same-origin /api.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# development | staging | production
VITE_ENV=development

# Set "false" to silence the event pipeline during local work.
VITE_EVENTS_ENABLED=false

# Optional CDN prefix for /public assets. Empty = same-origin.
VITE_ASSET_BASE=

# Injected by CI for build provenance in the admin dashboard.
VITE_COMMIT_SHA=

# NMI Collect.js PUBLIC tokenization key. Never the security key.
VITE_NMI_COLLECT_JS_KEY=

# Phase 1B age-calibration screen. Only `full_manuscript` is certified today, so this ships OFF.
VITE_AGE_LAYER_ENABLED=false

# Founding Reader beta build: shows "Continue to Observations" at S13.
VITE_BETA_MODE=false

# Which threshold carries S1–S7.
#   spline  a single authored Spline scene, self-hosted at /scene/entrance.splinecode
#   weave   the canonical R3F opening — darkness, speck, Living Weave, passage, Earth reveal
# Both exist deliberately: the Living Weave and the Earth reveal are canon (§2.5, §2.6, §8.6),
# and §1.3.1's No-Loss Rule forbids discarding a canonical engine. Flipping this back to
# "weave" restores the canonical opening with no code change.
VITE_ENTRANCE_MODE=spline

# Self-hosted Spline scenes. Paths on our own origin — never a prod.spline.design URL (§7.13).
# `invitation` falls back to `entrance` when unset.
VITE_SPLINE_ENTRANCE_SCENE=/scene/entrance.splinecode
VITE_SPLINE_INVITATION_SCENE=

# Interim admin sign-in gate — development only; production builds ignore it.
# This flag only hides the authenticator field. The credential lives on the API, in Backend
# ADMIN_DEV_NAME / ADMIN_DEV_PASSWORD, and is never mirrored here: Vite inlines every VITE_*
# variable into the built JavaScript, where anyone can read it.
# Delete this, and src/admin/adminLocalGate.js, before public launch.
VITE_ADMIN_LOCAL_GATE=true
